# Jira Cloud — create an API token at
# https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_EMAIL=you@example.com
JIRA_API_TOKEN=your-atlassian-api-token
# Jira site — full hostname (e.g. your-company.atlassian.net)
JIRA_SITE=your-company.atlassian.net

# AI narration layer (OpenAI-compatible; deepinfra serves the DeepSeek model
# configured in omp). Leave blank to generate data-only reports.
DEEPINFRA_API_KEY=
